# Local storage and API
VIDSEARCH_DATA_DIR=data
VIDSEARCH_MAX_VIDEO_BYTES=2000000000
VIDSEARCH_MAX_VIDEO_DURATION_SECONDS=3600

# Sampling and retrieval
VIDSEARCH_FRAME_RATE=1
VIDSEARCH_SEGMENT_SECONDS=10
VIDSEARCH_RETRIEVAL_TOP_K=20

# Local services
VIDSEARCH_QDRANT_URL=http://localhost:6333
VIDSEARCH_DATABASE_URL=sqlite:///data/vidsearch.db
REDIS_URL=redis://localhost:6379/0

# Optional model overrides; configure only the providers used in your setup.
VIDSEARCH_DEVICE=auto
VIDSEARCH_MODEL_CACHE_DIR=models
